<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused on TV Remote: refined frosted glass sheen + electric cyan specular rim -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#4D00E5FF"
                android:centerColor="#2000B0FF"
                android:endColor="#10030712" />
            <stroke
                android:width="2dp"
                android:color="#FF00E5FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#8000E5FF"
                android:endColor="#4000B0FF" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Selected state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3300E5FF"
                android:endColor="#1500B0FF" />
            <stroke
                android:width="1.5dp"
                android:color="#9900E5FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Default idle state: luxury tvOS frosted dark glass with subtle specular rim -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#22FFFFFF"
                android:centerColor="#1008101E"
                android:endColor="#E6040710" />
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
