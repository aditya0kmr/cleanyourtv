<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state for 10-foot remote navigation -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4500F0FF" />
            <stroke android:width="2.5dp" android:color="#00F0FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#7500F0FF" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Selected state (e.g. active tab/filter) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#3000F0FF" />
            <stroke android:width="2dp" android:color="#00F0FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Default idle state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D80B1320" />
            <stroke android:width="1.2dp" android:color="#3500F0FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
