<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state for remote navigation -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#5000F0FF" />
            <stroke android:width="2dp" android:color="#00F0FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#7000F0FF" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Selected state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#3500F0FF" />
            <stroke android:width="1.8dp" android:color="#00F0FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A00F0FF" />
            <stroke android:width="1dp" android:color="#2500F0FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
