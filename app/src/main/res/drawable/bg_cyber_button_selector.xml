<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused on TV Remote -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#5000F0FF" />
            <stroke android:width="2dp" android:color="#00F0FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#7000F0FF" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Default Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E60A111C" />
            <stroke android:width="1.2dp" android:color="#4000F0FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
