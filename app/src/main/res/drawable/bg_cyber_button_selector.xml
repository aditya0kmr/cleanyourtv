<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused on TV Remote -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF00E5FF"
                android:endColor="#FF00B0FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#7000E5FF" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Default Normal: sleek translucent glass button -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1E00E5FF"
                android:endColor="#0A07101E" />
            <stroke android:width="1dp" android:color="#3500E5FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
