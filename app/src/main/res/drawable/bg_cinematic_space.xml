<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deepest Obsidian-Navy Space Foundation -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#060C18"
                android:centerColor="#030710"
                android:endColor="#020408" />
        </shape>
    </item>

    <!-- Upper-Right Celestial Ambient Glow (Illuminates the Hero Stage) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="720dp"
                android:centerX="0.82"
                android:centerY="0.22"
                android:startColor="#1800E5FF"
                android:centerColor="#08005A8C"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Lower-Left Subtle Horizon Scrim -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="640dp"
                android:centerX="0.15"
                android:centerY="0.88"
                android:startColor="#0D002B4D"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
