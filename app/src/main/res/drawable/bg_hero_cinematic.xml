<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Cinematic Space Foundation -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0C1830"
                android:centerColor="#050914"
                android:endColor="#020409" />
        </shape>
    </item>

    <!-- Ethereal Nebula Radial Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:centerX="0.70"
                android:centerY="0.35"
                android:startColor="#3300E5FF"
                android:centerColor="#12007BBF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Celestial Horizon Light Accent -->
    <item
        android:gravity="bottom"
        android:bottom="24dp">
        <shape android:shape="rectangle">
            <size android:height="1.5dp" />
            <gradient
                android:angle="0"
                android:startColor="#00000000"
                android:centerColor="#6600E5FF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
