<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stream_deck_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5060A10"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/stream_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="@string/iptv_title"
            android:textColor="#00F0FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_close_stream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2000F0FF"
            android:fontFamily="monospace"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="[ DISENGAGE ]"
            android:textColor="#00F0FF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Holographic Video Frame with Tech Border -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_cyber_card"
        android:padding="4dp">

        <VideoView
            android:id="@+id/video_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Overlay Status Bar -->
        <TextView
            android:id="@+id/stream_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="#80000000"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="SIGNAL // CONNECTING..."
            android:textColor="#00F0FF"
            android:textSize="10sp" />

        <!-- Scanline subtle overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1500F0FF" />
    </FrameLayout>

    <!-- Channel Telemetry & Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="CH 01 // NASA TV LIVE"
            android:textColor="#F0F8FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_prev_ch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="#2000F0FF"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="&lt; PREV"
            android:textColor="#00F0FF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_next_ch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2000F0FF"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="NEXT &gt;"
            android:textColor="#00F0FF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Custom URL / M3U Stream Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_stream_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_card"
            android:fontFamily="monospace"
            android:hint="LOAD M3U / HLS URL..."
            android:maxLines="1"
            android:padding="8dp"
            android:textColor="#F0F8FF"
            android:textColorHint="#407A8E9E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_load_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="#3000F0FF"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="TUNE"
            android:textColor="#00F0FF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
