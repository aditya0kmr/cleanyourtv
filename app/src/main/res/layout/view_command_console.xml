<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/console_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0070D14"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Terminal Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/console_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="@string/terminal_title"
            android:textColor="#00F0FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_close_console"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2000F0FF"
            android:fontFamily="monospace"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="[ CLOSE ]"
            android:textColor="#00F0FF"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4000F0FF" />

    <!-- Output Log Console -->
    <ScrollView
        android:id="@+id/console_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/console_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:textColor="#C0E0F0"
            android:textSize="12sp" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4000F0FF" />

    <!-- Command Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/prompt_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="AETHER:~$ "
            android:textColor="#00F0FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_command"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="@string/search_hint"
            android:imeOptions="actionSend"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:textColor="#F0F8FF"
            android:textColorHint="#407A8E9E"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_exec_command"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#3000F0FF"
            android:fontFamily="monospace"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="EXEC"
            android:textColor="#00F0FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
