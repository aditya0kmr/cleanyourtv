<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_launcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- PRIMARY 16:9 SPLIT-STAGE COMMAND CONSOLE -->
    <LinearLayout
        android:id="@+id/main_stage_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. TOP HEADER & STATUS BAR (Apple-Grade Minimalist Header) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#4004070E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <TextView
                android:id="@+id/txt_tactical_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="AETHER"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="NEXUS"
                android:textColor="#00E5FF"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txt_chrono_stardate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="6:18 PM  ·  STARDATE 2026.302"
                android:textColor="#D0E0EE"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txt_telemetry_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_cyber_button_selector"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Wi-Fi Online"
                android:textColor="#00E5FF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_theme_cycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@+id/btn_toggle_hero"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="THEME"
                android:textColor="#D0E0EE"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. UNIFIED CINEMATIC HERO STAGE (Apple TV / tvOS Inspired Spotlight) -->
        <LinearLayout
            android:id="@+id/stage_hero_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="36dp"
            android:paddingTop="8dp"
            android:paddingEnd="36dp"
            android:paddingBottom="8dp">

            <!-- LEFT: FEATURED APP SPOTLIGHT & METADATA (Expansive, Generous Breathing Room) -->
            <LinearLayout
                android:id="@+id/container_app_spotlight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingEnd="28dp">

                <!-- App Artwork Showcase (Banner or High-Res Icon Frame) -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <!-- Wide TV Banner Image (if available) -->
                    <ImageView
                        android:id="@+id/hero_app_banner"
                        android:layout_width="260dp"
                        android:layout_height="146dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <!-- High-Res App Icon Frame (fallback when banner absent) -->
                    <FrameLayout
                        android:id="@+id/hero_app_icon_frame"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/glass_panel"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/dossier_app_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_launcher" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Featured App Title -->
                <TextView
                    android:id="@+id/dossier_app_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Select an Application"
                    android:textColor="#FFFFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <!-- Category Pill Badge & TV Tag -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dossier_app_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cyber_tab_selector"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="14dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="4dp"
                        android:text="STREAMING ENTERTAINMENT"
                        android:textColor="#00E5FF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/dossier_app_package"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="sans-serif"
                        android:text="1080p Television Optimized"
                        android:textColor="#809BB0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Primary Action Hint Button -->
                <TextView
                    android:id="@+id/btn_hero_launch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_cyber_button_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btn_theme_cycle"
                    android:nextFocusRight="@+id/btn_toggle_hero"
                    android:nextFocusDown="@+id/recycler_horizontal_shelf"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="20dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="7dp"
                    android:text="▶  OPEN APPLICATION"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- RIGHT: MEDIA & AMBIENT CORE PREVIEW FRAME (Enclosed in Frosted Glass Panel) -->
            <FrameLayout
                android:id="@+id/container_hero_stage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.0"
                android:background="@drawable/glass_panel"
                android:padding="8dp">

                <!-- Mode 1: Optional Kinetic Arc Reactor Visualizer -->
                <com.aether.launcher.hud.ArcReactorView
                    android:id="@+id/arc_reactor_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Mode 2: Docked Live Picture-in-Picture AV Monitor -->
                <FrameLayout
                    android:id="@+id/hero_video_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <VideoView
                        android:id="@+id/hero_video_player"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <!-- Stream Info Overlay -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="#B0000000"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/hero_channel_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="CH 01 · NASA TV LIVE"
                            android:textColor="#F0F8FF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/hero_stream_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="ONLINE"
                            android:textColor="#00FF66"
                            android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Stage Mode Toggle Button (Top Right of Preview Frame) -->
                <TextView
                    android:id="@+id/btn_toggle_hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_cyber_button_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btn_theme_cycle"
                    android:nextFocusLeft="@+id/btn_hero_launch"
                    android:nextFocusDown="@+id/recycler_horizontal_shelf"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="▶ LIVE AV"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- 3. LOWER SHELF AREA: CATEGORY TABS & HORIZONTAL CAROUSEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Category Tabs -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/shelf_category_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Horizontal App Carousel Shelf (10-foot TV Remote D-Pad Navigation) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_horizontal_shelf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:paddingStart="32dp"
                android:paddingTop="6dp"
                android:paddingEnd="32dp"
                android:paddingBottom="6dp"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- 4. BOTTOM DOCK & SHORTCUT BAR -->
        <LinearLayout
            android:id="@+id/bottom_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#8004070E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <TextView
                android:id="@+id/txt_bottom_hints"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="▲ Spotlight   ◀ ▶ Browse Apps   ● Open"
                android:textColor="#809BB0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_open_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/recycler_horizontal_shelf"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="ALL APPS"
                android:textColor="#D0E0EE"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_open_arcade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/recycler_horizontal_shelf"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="ARCADE"
                android:textColor="#D0E0EE"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_open_iptv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/recycler_horizontal_shelf"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="LIVE TV"
                android:textColor="#D0E0EE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- LAYER 2: Android AppWidget Container (Optional) -->
    <FrameLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="24dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="24dp"
        android:visibility="gone" />

    <!-- LAYER 5: Holographic App Matrix Overlay (Strictly Preserved Fallback) -->
    <LinearLayout
        android:id="@+id/drawer_app_matrix"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5070D14"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="// HOLOGRAPHIC APP MATRIX (FALLBACK GRID) //"
                android:textColor="#00F0FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_close_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="[ CLOSE ]"
                android:textColor="#00F0FF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categories_chip_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- LAYER 6: Cyber Terminal Console Overlay -->
    <include
        android:id="@+id/overlay_console"
        layout="@layout/view_command_console"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- LAYER 7: IPTV Video Stream Deck Overlay -->
    <include
        android:id="@+id/overlay_stream_deck"
        layout="@layout/view_stream_deck"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- LAYER 8: Holo-Arcade View Overlay -->
    <com.aether.launcher.arcade.HoloArcadeView
        android:id="@+id/overlay_arcade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
