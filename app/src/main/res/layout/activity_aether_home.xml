<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_launcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- PRIMARY 16:9 SPLIT-STAGE COMMAND CONSOLE -->
    <LinearLayout
        android:id="@+id/main_stage_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. TOP DIAGNOSTICS & STARDATE BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="#D0060A10"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/txt_tactical_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="AETHER // NEXUS"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_chrono_stardate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="00:00:00 UTC  ·  STARDATE 2026.302"
                android:textColor="#D0E0EE"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txt_telemetry_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif"
                android:text="WI-FI ONLINE · 144M"
                android:textColor="#00E5FF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_theme_cycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="THEME: CYBER"
                android:textColor="#00E5FF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. MIDDLE SPLIT STAGE: HERO MONITOR & DYNAMIC DOSSIER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp">

            <!-- LEFT STAGE: HERO MONITOR / CORE (Mutual Exclusion Engine) -->
            <FrameLayout
                android:id="@+id/container_hero_stage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1.3"
                android:background="@drawable/glass_panel"
                android:padding="8dp">

                <!-- Mode 1: Kinetic Arc Reactor Visualizer -->
                <com.aether.launcher.hud.ArcReactorView
                    android:id="@+id/arc_reactor_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Mode 2: Docked Live Picture-in-Picture AV Monitor -->
                <FrameLayout
                    android:id="@+id/hero_video_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <VideoView
                        android:id="@+id/hero_video_player"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <!-- Scanline HUD effect -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#1500F0FF" />

                    <!-- Stream Info Overlay -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="#A0000000"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/hero_channel_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="CH 01 · NASA TV LIVE"
                            android:textColor="#F0F8FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_stream_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="SIGNAL · 1080p ONLINE"
                            android:textColor="#00FF66"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/btn_hero_prev_ch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_cyber_button_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="&lt;"
                            android:textColor="#00E5FF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btn_hero_next_ch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_cyber_button_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="&gt;"
                            android:textColor="#00E5FF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Stage Header & Mutual-Exclusion Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/txt_hero_mode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="CINEMATIC CORE"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_toggle_hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cyber_button_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="▶ LIVE AV MONITOR"
                        android:textColor="#FFFFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- RIGHT STAGE: DYNAMIC ACTIVE DOSSIER & HARDWARE RADAR -->
            <LinearLayout
                android:id="@+id/container_dossier_stage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:background="@drawable/glass_panel"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="ACTIVE APPLICATION DOSSIER"
                    android:textColor="#809BB0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Dynamic Focused App Profile -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/dossier_app_icon"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_cyber_card"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_launcher" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/dossier_app_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="AETHER — NEXUS"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dossier_app_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="APPLICATION · SYSTEM"
                            android:textColor="#00E5FF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/dossier_app_package"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:text="com.aether.launcher · 1080p Compatible"
                            android:textColor="#809BB0"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="#15FFFFFF" />

                <!-- Hardware Performance Radar -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="DEVICE PERFORMANCE"
                    android:textColor="#809BB0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/radar_cpu_gauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="CPU LOAD: 48% · QUAD-CORE 64-BIT"
                    android:textColor="#D0E0EE"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/radar_ram_gauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="MEMORY: 570 MB / 922 MB (62%) · 352 MB FREE"
                    android:textColor="#D0E0EE"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/radar_power_gauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="POWER: AC CONNECTED · 32.4°C COOL"
                    android:textColor="#D0E0EE"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/radar_net_gauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="WI-FI: 5GHz · 144 Mbps ONLINE"
                    android:textColor="#D0E0EE"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. LOWER SHELF AREA: CATEGORY TABS & HORIZONTAL CAROUSEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#B0060A10"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Category Tabs -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/shelf_category_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Horizontal App Carousel Shelf (10-foot TV Remote D-Pad Navigation) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_horizontal_shelf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- 4. BOTTOM TACTICAL HINT & SHORTCUT BAR -->
        <LinearLayout
            android:id="@+id/bottom_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#E605080E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/txt_bottom_hints"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="▲ HERO STAGE   ◀ ▶ BROWSE APPS   ● LAUNCH   ▼ SHORTCUTS"
                android:textColor="#809BB0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_open_terminal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="11dp"
                android:paddingTop="4dp"
                android:paddingEnd="11dp"
                android:paddingBottom="4dp"
                android:text="TERMINAL"
                android:textColor="#D0E0EE"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_open_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="11dp"
                android:paddingTop="4dp"
                android:paddingEnd="11dp"
                android:paddingBottom="4dp"
                android:text="APP MATRIX"
                android:textColor="#D0E0EE"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_open_arcade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="11dp"
                android:paddingTop="4dp"
                android:paddingEnd="11dp"
                android:paddingBottom="4dp"
                android:text="HOLO ARCADE"
                android:textColor="#D0E0EE"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_open_iptv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="11dp"
                android:paddingTop="4dp"
                android:paddingEnd="11dp"
                android:paddingBottom="4dp"
                android:text="LIVE AV"
                android:textColor="#D0E0EE"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_add_widget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="11dp"
                android:paddingTop="4dp"
                android:paddingEnd="11dp"
                android:paddingBottom="4dp"
                android:text="+WIDGET"
                android:textColor="#D0E0EE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- LAYER 2: Android AppWidget Container (Optional) -->
    <FrameLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="24dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="24dp"
        android:visibility="gone" />

    <!-- LAYER 5: Holographic App Matrix Overlay (Strictly Preserved Fallback) -->
    <LinearLayout
        android:id="@+id/drawer_app_matrix"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5070D14"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="// HOLOGRAPHIC APP MATRIX (FALLBACK GRID) //"
                android:textColor="#00F0FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_close_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="[ CLOSE ]"
                android:textColor="#00F0FF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categories_chip_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- LAYER 6: Cyber Terminal Console Overlay -->
    <include
        android:id="@+id/overlay_console"
        layout="@layout/view_command_console"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- LAYER 7: IPTV Video Stream Deck Overlay -->
    <include
        android:id="@+id/overlay_stream_deck"
        layout="@layout/view_stream_deck"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- LAYER 8: Holo-Arcade View Overlay -->
    <com.aether.launcher.arcade.HoloArcadeView
        android:id="@+id/overlay_arcade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
