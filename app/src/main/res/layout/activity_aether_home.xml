<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_launcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cinematic_space">

    <!-- PRIMARY 16:9 SPLIT-STAGE COMMAND CONSOLE -->
    <LinearLayout
        android:id="@+id/main_stage_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. TOP HEADER & STATUS BAR (Minimalist tvOS Header) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="#26030710"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">

            <TextView
                android:id="@+id/txt_tactical_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="AETHER"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="CINEMATIC"
                android:textColor="#00E5FF"
                android:textSize="11.5sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txt_chrono_stardate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="6:18 PM  ·  STARDATE 2026.302"
                android:textColor="#C0D4E8"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/txt_telemetry_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_cyber_button_selector"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="Wi-Fi Online"
                android:textColor="#00E5FF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_theme_cycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@+id/btn_hero_launch"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="THEME"
                android:textColor="@color/btn_text_color_selector"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. EXPANSIVE CINEMATIC HERO STAGE (Unified Showcase with Artwork Scrim) -->
        <FrameLayout
            android:id="@+id/stage_hero_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="40dp"
            android:paddingTop="8dp"
            android:paddingEnd="40dp"
            android:paddingBottom="6dp">

            <!-- WIDESCREEN HERO ARTWORK & PREVIEW STAGE (Right-Aligned Atmospheric Canvas) -->
            <FrameLayout
                android:id="@+id/container_hero_stage"
                android:layout_width="560dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp">

                <!-- Mode 0: Cinematic Landscape Showcase (Default) -->
                <FrameLayout
                    android:id="@+id/hero_art_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- High-Resolution Landscape Artwork / Banner -->
                    <ImageView
                        android:id="@+id/hero_backdrop_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_hero_cinematic" />

                    <!-- Seamless Horizontal Scrim (Fades artwork into the dark left stage) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/scrim_hero_horizontal" />
                </FrameLayout>

                <!-- Mode 1: Optional Kinetic Arc Reactor Visualizer -->
                <com.aether.launcher.hud.ArcReactorView
                    android:id="@+id/arc_reactor_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Mode 2: Docked Live Picture-in-Picture AV Monitor -->
                <FrameLayout
                    android:id="@+id/hero_video_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <VideoView
                        android:id="@+id/hero_video_player"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:focusable="false"
                        android:focusableInTouchMode="false" />

                    <!-- Stream Info Overlay -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="#B0000000"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/hero_channel_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="CH 01 · NASA TV LIVE"
                            android:textColor="#F0F8FF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/hero_stream_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="ONLINE"
                            android:textColor="#00FF66"
                            android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <!-- LEFT: FEATURED APP SPOTLIGHT & METADATA (Overlays Left Side with 10-Foot Legibility) -->
            <LinearLayout
                android:id="@+id/container_app_spotlight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <!-- Floating App Icon Badge & Optional Leanback Banner -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:id="@+id/hero_app_icon_frame"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_glass_icon_badge"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/dossier_app_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_launcher" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/hero_app_banner"
                        android:layout_width="220dp"
                        android:layout_height="124dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Featured App Title (Large, Crisp 34sp Typography) -->
                <TextView
                    android:id="@+id/dossier_app_name"
                    android:layout_width="560dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Select an Application"
                    android:textColor="#FFFFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <!-- Category Pill Badge & Subtitle Meta Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dossier_app_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cyber_tab_selector"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="12dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="3dp"
                        android:text="STREAMING ENTERTAINMENT"
                        android:textColor="#00E5FF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/dossier_app_package"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:fontFamily="sans-serif"
                        android:text="1080p Television Optimized"
                        android:textColor="#88A0B2"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Action Button Row: [ ▶ OPEN APPLICATION ]   [ ⟐ AMBIENT CORE ] -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_hero_launch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cyber_button_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusUp="@+id/btn_theme_cycle"
                        android:nextFocusRight="@+id/btn_toggle_hero"
                        android:nextFocusDown="@+id/recycler_horizontal_shelf"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="22dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="8dp"
                        android:text="▶  OPEN APPLICATION"
                        android:textColor="@color/btn_text_color_selector"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btn_toggle_hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_cyber_button_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusUp="@+id/btn_theme_cycle"
                        android:nextFocusLeft="@+id/btn_hero_launch"
                        android:nextFocusDown="@+id/recycler_horizontal_shelf"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="⟐  AMBIENT CORE"
                        android:textColor="@color/btn_text_color_selector"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- 3. LOWER SHELF AREA: CATEGORY TABS & HORIZONTAL CAROUSEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <!-- Category Tabs -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/shelf_category_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Horizontal App Carousel Shelf (10-foot TV Remote D-Pad Navigation) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_horizontal_shelf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:paddingStart="32dp"
                android:paddingTop="10dp"
                android:paddingEnd="32dp"
                android:paddingBottom="10dp"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- 4. BOTTOM DOCK & SHORTCUT BAR -->
        <LinearLayout
            android:id="@+id/bottom_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_cyber_dock"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <TextView
                android:id="@+id/btn_open_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/recycler_horizontal_shelf"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="APP MATRIX"
                android:textColor="@color/btn_text_color_selector"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_open_arcade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/recycler_horizontal_shelf"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="ARCADE"
                android:textColor="@color/btn_text_color_selector"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_open_iptv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/recycler_horizontal_shelf"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="LIVE TV"
                android:textColor="@color/btn_text_color_selector"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_open_terminal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/recycler_horizontal_shelf"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="TERMINAL"
                android:textColor="@color/btn_text_color_selector"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- LAYER 2: Android AppWidget Container (Optional) -->
    <FrameLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="24dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="24dp"
        android:visibility="gone" />

    <!-- LAYER 5: Holographic App Matrix Overlay (Strictly Preserved Fallback) -->
    <LinearLayout
        android:id="@+id/drawer_app_matrix"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5070D14"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="// HOLOGRAPHIC APP MATRIX (FALLBACK GRID) //"
                android:textColor="#00F0FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_close_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@+id/categories_chip_container"
                android:fontFamily="monospace"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="[ CLOSE ]"
                android:textColor="@color/btn_text_color_selector"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categories_chip_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- LAYER 6: Cyber Terminal Console Overlay -->
    <include
        android:id="@+id/overlay_console"
        layout="@layout/view_command_console"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- LAYER 7: IPTV Video Stream Deck Overlay -->
    <include
        android:id="@+id/overlay_stream_deck"
        layout="@layout/view_stream_deck"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- LAYER 8: Holo-Arcade View Overlay -->
    <com.aether.launcher.arcade.HoloArcadeView
        android:id="@+id/overlay_arcade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
